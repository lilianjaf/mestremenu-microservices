# Copy this file to .env and fill in the values before running docker compose.
# cp .env.example .env

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=mestremenu
POSTGRES_USER=mestremenu
POSTGRES_PASSWORD=

# ── Spring ────────────────────────────────────────────────────────────────────
# Active profile used by all services when running via Docker Compose.
# Do NOT change this to "dev" here — "dev" profile uses localhost hostnames.
SPRING_PROFILES_ACTIVE=docker

# ── JWT ───────────────────────────────────────────────────────────────────────
# Shared secret used by usuario-service to sign tokens and by gateway-service
# to verify them. Must be the same value in all services.
# Use a long random string in production (e.g. openssl rand -hex 32).
JWT_SECRET=

# ── Grafana local ─────────────────────────────────────────────────────────────
# Admin password for the Grafana UI at http://localhost:3000.
# Defaults to "admin" if left blank.
GRAFANA_PASSWORD=

# ── Grafana Cloud (optional) ──────────────────────────────────────────────────
# Fill these in after creating a free account at https://grafana.com.
# Then uncomment the remote_write block in monitoring/prometheus.yml.
GRAFANA_CLOUD_URL=
GRAFANA_CLOUD_USER=
GRAFANA_CLOUD_KEY=
